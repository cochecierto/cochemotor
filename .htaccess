# ==============================================================================
# CocheMotor — Configuración Web para Hostinger (.htaccess)
# Producción: https://motor.cochecierto.com/
# Preview Hostinger: https://motor.cochecierto.com/
# ==============================================================================

DirectoryIndex index.html

# Forzar codificación UTF-8
AddDefaultCharset UTF-8

# Tipos MIME correctos para fuentes, svg y json
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
</IfModule>

# Reglas de Reescritura
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Seguridad: bloquear acceso a carpetas internas sensibles
  RewriteRule ^\.agents - [F,L]
  RewriteRule ^\.github - [F,L]
  RewriteRule ^\.codex - [F,L]
  RewriteRule ^specs - [F,L]
  RewriteRule ^database - [F,L]
</IfModule>

# Cabeceras de Caché para Optimización de Rendimiento
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
