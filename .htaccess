# ==============================================================================
# CocheMotor — Configuración Web para Hostinger (.htaccess)
# Producción: https://cochemotor.es/
# Preview Hostinger: https://cochemotor.es/
# ==============================================================================

DirectoryIndex index.php index.html

# Forzar codificación UTF-8
AddDefaultCharset UTF-8

# Tipos MIME correctos para fuentes, svg y json
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType application/json .json
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
</IfModule>

# Reglas de Reescritura
<IfModule mod_rewrite.c>
RewriteEngine On
# Rutas públicas limpias. Las URLs antiguas con .html se redirigen más abajo
# para que los enlaces compartidos y los marcadores no se rompan.
RewriteRule ^marketplace/?$ marketplace.html [END]
RewriteRule ^demanda/?$ demanda.html [END]
RewriteRule ^profesionales/?$ profesionales.html [END]
RewriteRule ^publicar/?$ publicar.html [END]
RewriteRule ^panel/?$ hub.html [END]
RewriteRule ^acceso/?$ acceso.html [END]
RewriteRule ^perfil/?$ perfil.html [END]
RewriteRule ^dealer/?$ dealer.html [END]
RewriteRule ^ficha/?$ ficha.html [END]
RewriteRule ^aviso-legal/?$ aviso-legal.html [END]
RewriteRule ^privacidad/?$ privacidad.html [END]
RewriteRule ^terminos/?$ terminos.html [END]
RewriteRule ^denuncia/?$ denuncia.html [END]
RewriteRule ^feedback-beta/?$ feedback-beta.html [END]
RewriteRule ^asesor/?$ asesor.html [END]
RewriteRule ^asesor-leads/?$ asesor-leads.html [END]
# Canonicalizar accesos directos antiguos cuando vienen del navegador.
RewriteCond %{THE_REQUEST} \s/+marketplace\.html(?:[?\s]) [NC]
RewriteRule ^marketplace\.html$ /marketplace [R=301,END,NE]
RewriteCond %{THE_REQUEST} \s/+hub\.html(?:[?\s]) [NC]
RewriteRule ^hub\.html$ /panel [R=301,END,NE]
RewriteCond %{THE_REQUEST} \s/+demanda\.html(?:[?\s]) [NC]
RewriteRule ^demanda\.html$ /demanda [R=301,END,NE]
RewriteCond %{THE_REQUEST} \s/+profesionales\.html(?:[?\s]) [NC]
RewriteRule ^profesionales\.html$ /profesionales [R=301,END,NE]
RewriteCond %{THE_REQUEST} \s/+publicar\.html(?:[?\s]) [NC]
RewriteRule ^publicar\.html$ /publicar [R=301,END,NE]
RewriteCond %{THE_REQUEST} \s/+acceso\.html(?:[?\s]) [NC]
RewriteRule ^acceso\.html$ /acceso [R=301,END,NE]
RewriteRule ^sitemap\.xml$ sitemap-public.php [L]
RewriteRule ^vehiculos/([a-z0-9][a-z0-9-]{2,179})/?$ seo-public.php?kind=vehicle&slug=$1 [QSA,L,NC]
RewriteRule ^profesionales/([a-z0-9][a-z0-9-]{2,179})/?$ seo-public.php?kind=dealer&slug=$1 [QSA,L,NC]
# Alias de marca para la web propia del profesional: /juan-gomez
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9][a-z0-9-]{2,179})/?$ seo-public.php?kind=dealer&slug=$1 [QSA,L,NC]
RewriteCond %{QUERY_STRING} (^|&)id=([A-Za-z0-9_-]{1,80})(&|$)
RewriteRule ^ficha\.html$ seo-legacy-redirect.php?kind=vehicle&id=%2 [L,NC]
RewriteCond %{QUERY_STRING} (^|&)slug=([A-Za-z0-9_-]{1,180})(&|$)
RewriteRule ^dealer\.html$ seo-legacy-redirect.php?kind=dealer&id=%2 [L,NC]
RewriteCond %{QUERY_STRING} (^|&)id=([A-Za-z0-9_-]{1,80})(&|$)
RewriteRule ^dealer\.html$ seo-legacy-redirect.php?kind=dealer&id=%2 [L,NC]
RewriteRule ^api/auth/verify$ api/index.php [L,QSA]
RewriteRule ^api/(.*)$ api/index.php [L,QSA]

  # Seguridad: bloquear acceso a carpetas internas sensibles
  RewriteRule ^\.agents - [F,L]
  RewriteRule ^\.github - [F,L]
  RewriteRule ^\.codex - [F,L]
  RewriteRule ^specs - [F,L]
  RewriteRule ^database - [F,L]
  RewriteRule ^(docs|scripts|tests|local-broker|wordpress|references|app)(/|$) - [F,L,NC]
  RewriteRule ^(\.git|\.env(?:\..*)?)(/|$) - [F,L,NC]
  RewriteRule ^(AGENTS\.md|README\.md|deploy_hostinger\.py|sync_web\.py|\.gitignore)$ - [F,L,NC]
RewriteRule (^|/)[^/]+\.(zip|py|bat|sh|md|log|db|sqlite|sqlite3|sql)$ - [F,L,NC]
</IfModule>

# Cabeceras de Caché para Optimización de Rendimiento
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-LiteSpeed-Purge "*"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
